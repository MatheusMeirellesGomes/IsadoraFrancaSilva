# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commitar o .env.local (já está no .gitignore).

# Supabase — criado na Etapa 8 (Banco de dados)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp profissional — usado no redirecionamento de agendamento (Etapa 9)
NEXT_PUBLIC_WHATSAPP_NUMBER=5531995262194

# Helena — somente servidor. Não usar NEXT_PUBLIC_ para a chave.
OPENAI_API_KEY=
# ID de um modelo disponível na sua conta, compatível com Responses API.
OPENAI_MODEL=

# Alternativa local sem chave: ollama (apenas quando o Ollama estiver instalado)
HELENA_PROVIDER=openai
OLLAMA_MODEL=qwen3:4b-instruct

# E-mails do agendamento (Etapa 7 / Etapa 17) — somente servidor.
# Crie uma conta gratuita em https://resend.com, verifique um domínio ou
# use o remetente de teste deles, e gere uma API key.
RESEND_API_KEY=
# Precisa ser um remetente/domínio verificado no Resend.
RESEND_FROM_EMAIL=
# E-mail da Isadora para receber a notificação de novo pedido de agendamento.
ISADORA_NOTIFICATION_EMAIL=isadorafrancasilva@gmail.com

# Lembrete de pós-procedimento (Etapa 17) — protege /api/cron/lembretes.
# Gere uma string aleatória qualquer (ex: openssl rand -hex 32) e coloque
# o MESMO valor nas variáveis de ambiente do projeto na Vercel — ela
# manda automaticamente esse valor como "Authorization: Bearer <valor>"
# ao chamar cron jobs, então não precisa (nem deve) configurar isso em
# nenhum outro lugar.
CRON_SECRET=
